# ============================================
# HPMS Frontend - Environment Variables
# ============================================
# 
# HOW TO USE:
#   1. Copy this file and rename it to ".env.local" (remove .example)
#   2. Make sure your Django backend is running (run.bat)
#   3. Start the React frontend (npm run dev)
#
# When USE_LIVE_API is "true", the frontend talks to your Django backend.
# When USE_LIVE_API is "false" or missing, it uses built-in mock/demo data.
# ============================================

# Set to "true" to connect to your Django backend
NEXT_PUBLIC_USE_LIVE_API=true

# Django backend API URL (don't change unless you changed Django's port)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
